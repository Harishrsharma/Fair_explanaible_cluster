 "id": "2e1abfce",
 "metadata": {},
 "outputs": [],
 "source": [
 "# ============================================================\n",
 "# CELL 12 — EXPLAINABILITY METRICS\n",
 "# FIX: now accepts feature_names so tree shows real column names\n",
 "# ============================================================\n",
 "def explainability_metrics(X, labels, feature_names=None):\n",
 "\n",
 " clf = DecisionTreeClassifier(max_depth=4, random_state=42)\n",
 " clf.fit(X, labels)\n",
 "\n",
 " result = {\n",
 " "tree_fidelity": clf.score(X, labels),\n",
 " "tree_depth": clf.get_depth(),\n",
 " "tree_leaves": clf.get_n_leaves()\n",
 " }\n",
 "\n",
 " # Print human-readable tree rules if feature names provided\n",
 " if feature_names is not None:\n",
 " print("\nDecision Tree Rules:")\n",
 " print(export_text(clf, feature_names=list(feature_names)))\n",
 "\n",
 " return result\n"
 ]
 },
 {
 "cell_type": "code",
 "execution_count": null,
 "id": "b1f1bf91",
 "metadata": {},
 "outputs": [],
 "source": [
 "# ============================================================\n",
 "# CELL 13 — PROTOTYPE QUALITY (unchanged from original)\n",
 "# ============================================================\n",
 "def prototype_quality(X, labels):\n",
 "\n",
 " K = len(np.unique(labels))\n",
 " distances = []\n",
 "\n",
 " for k in range(K):\n",
 " pts = X[labels == k]\n",
 " center = pts.mean(axis=0)\n",
 " d = np.linalg.norm(pts - center, axis=1)\n",
 " distances.append(np.mean(d))\n",
 "\n",
 " return np.mean(distances)\n"
 ]
 },
