 "source": [
 "# ============================================================\n",
 "# CELL 10 — ASSIGN LABELS HELPER\n",
 "# FIX: main() now uses this function instead of inline loop\n",
 "# ============================================================\n",
 "def assign_labels(fairlets, center_labels, n):\n",
 "\n",
 " labels = np.zeros(n, dtype=int)\n",
 "\n",
 " for fl, lab in zip(fairlets, center_labels):\n",
 " for idx in fl:\n",
 " labels[idx] = lab\n",
 "\n",
 " return labels\n"
 ]
 },
