 "# ============================================================\n",
 "# CELL 2 — CONFIGURATION CONSTANTS (unchanged from original)\n",
 "# ============================================================\n",
 "K_CLUSTERS = 3\n",
 "P = 1\n",
 "Q = 1\n",
 "RANDOM_STATE = 42\n",
 "SAMPLE_SIZE = 1000\n",
 "MAX_TREE_DEPTH = 5\n",
 "MIN_NODE_SIZE = 20\n"
 ]
 },
