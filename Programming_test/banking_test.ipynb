 "# ============================================================\n",
 "# CELL 15 — MAIN FUNCTION\n",
 "# FIXES (by GitHub Copilot, 2026-03-09):\n",
 "# 1. load_data() now unpacks all 3 values (was missing feature_names)\n",
 "# 2. assign_labels() helper is now used (removed duplicate inline loop)\n",
 "# 3. explainability_metrics() now receives feature_names\n",
 "# 4. run_baseline() is called first for comparison\n",
 "# 5. Side-by-side comparison table printed at end\n",
 "# ============================================================\n",
 "def main():\n",
 "\n",
 " # ----------------------------------------------------------\n",
 " # STEP 1 — Load & preprocess data\n",
 " # ----------------------------------------------------------\n",
 " print("Loading data...")\n",
 " # FIX: unpack all 3 values (was only unpacking 2)\n",
 " X, sensitive, feature_names = load_data()\n",
 " print("Data shape     :", X.shape)\n",
 " print("Sensitive attr :", sensitive.sum(), "married /",\n",
 " (sensitive == 0).sum(), "non-married")\n",
 "\n",
 " # ----------------------------------------------------------\n",
 " # STEP 2 — Run BASELINE (Normal KMeans)\n",
 " # ----------------------------------------------------------\n",
 " (\n",
 " baseline_labels,\n",
 " b_sil, b_db,\n",
 " b_fm, b_em, b_pq\n",
 " ) = run_baseline(X, sensitive, feature_names)\n",
 "\n",
 " # ----------------------------------------------------------\n",
 " # STEP 3 — Run FAIR CLUSTERING (Fairlet + KMedoids)\n",
 " # ----------------------------------------------------------\n",
 " print("\n" + "="*60)\n",
 " print("FAIR CLUSTERING: FAIRLET DECOMPOSITION + KMEDOIDS")\n",
 " print("="*60)\n",
 "\n",
 " print("\nBuilding spatial tree...")\n",
 " root = build_tree(X, list(range(len(X))))\n",
 "\n",
 " print("Running tree-based fairlet decomposition...")\n",
 " fairlets, leftovers = tree_fairlet_decomposition(\n",
 " root, X, sensitive\n",
 " )\n",
 "\n",
 " print("\nFAIRLET SUMMARY")\n",
 " print("----------------")\n",
 " print("Total fairlets        :", len(fairlets))\n",
 " print("Total assigned points :", sum(len(fl) for fl in fairlets))\n",
 " print("Leftovers (unassigned):", len(leftovers))\n",
 "\n",
 " centers = compute_fairlet_centers(X, fairlets)\n",
 "\n",
 " center_labels, medoids = kmedoids(\n",
 " X[centers],\n",
 " K_CLUSTERS\n",
 " )\n",
 "\n",
 " # FIX: use assign_labels() helper\n",
 " fair_labels = assign_labels(fairlets, center_labels, len(X))\n",
 "\n",
 " if len(leftovers) > 0:\n",
 " medoid_points = X[centers][medoids]\n",
 " distances = cdist(X[leftovers], medoid_points)\n",
 " leftover_labels = np.argmin(distances, axis=1)\n",
 " for idx, lab in zip(leftovers, leftover_labels):\n",
 " fair_labels[idx] = lab\n",
 " print("Leftovers assigned to nearest clusters.")\n",
 "\n",
 " print("\nCLUSTERING QUALITY")\n",
 " print("------------------")\n",
 " f_sil = silhouette_score(X, fair_labels)\n",
 " f_db  = davies_bouldin_score(X, fair_labels)\n",
 " print("Silhouette    :", f_sil)\n",
 " print("Davies-Bouldin:", f_db)\n",
 "\n",
 " print("\nFAIRNESS")\n",
 " print("--------")\n",
 " f_fm = fairness_metrics(fair_labels, sensitive)\n",
 " for k, v in f_fm.items():\n",
 " print(k, ":", v)\n",
 "\n",
 " print("\nEXPLAINABILITY")\n",
 " print("--------------")\n",
 " # FIX: pass feature_names so tree uses real column names\n",
 " f_em = explainability_metrics(X, fair_labels, feature_names)\n",
 " for k, v in f_em.items():\n",
 " print(k, ":", v)\n",
 "\n",
 " print("\nPROTOTYPE QUALITY")\n",
 " print("-----------------")\n",
 " f_pq = prototype_quality(X, fair_labels)\n",
 " print("avg_distance:", f_pq)\n",
 "\n",
 " # ----------------------------------------------------------\n",
 " # STEP 4 — SIDE-BY-SIDE COMPARISON TABLE\n",
 " # NEW — added by GitHub Copilot (2026-03-09)\n",
 " # ----------------------------------------------------------\n",
 " print("\n" + "="*60)\n",
 " print("COMPARISON: NORMAL KMEANS  vs  FAIR KMEDOIDS")\n",
 " print("="*60)\n",
 " print(f"{'Metric':<30} {'KMeans':>12} {'Fair KMedoids':>15} {'Change':>10}")\n",
 " print("-"*70)\n",
 "\n",
 " def row(label, v1, v2, higher_is_better=True):\n",
 " diff = v2 - v1\n",
 " if higher_is_better:\n",
 " arrow = "BETTER" if diff > 0 else ("WORSE" if diff < 0 else "SAME")\n",
 " else:\n",
 " arrow = "BETTER" if diff < 0 else ("WORSE" if diff > 0 else "SAME")\n",
 " print(f"{label:<30} {v1:>12.4f} {v2:>15.4f} {arrow:>10}")\n",
 "\n",
 " print("--- CLUSTERING QUALITY ---")\n",
 " row("Silhouette Score",     b_sil,                 f_sil,                 higher_is_better=True)\n",
 " row("Davies-Bouldin Score", b_db,                  f_db,                  higher_is_better=False)\n",
 " print("--- FAIRNESS ---")\n",
 " row("avg_balance",          b_fm['avg_balance'],   f_fm['avg_balance'],   higher_is_better=True)\n",
 " row("violation_rate",       b_fm['violation_rate'],f_fm['violation_rate'],higher_is_better=False)\n",
 " row("avg_dp_gap",           b_fm['avg_dp_gap'],    f_fm['avg_dp_gap'],    higher_is_better=False)\n",
 " print("--- EXPLAINABILITY ---")\n",
 " row("tree_fidelity",        b_em['tree_fidelity'], f_em['tree_fidelity'], higher_is_better=True)\n",
 " row("tree_depth",           b_em['tree_depth'],    f_em['tree_depth'],    higher_is_better=False)\n",
 " row("tree_leaves",          b_em['tree_leaves'],   f_em['tree_leaves'],   higher_is_better=False)\n",
 " print("--- PROTOTYPE QUALITY ---")\n",
 " row("avg_distance",         b_pq,                  f_pq,                  higher_is_better=False)\n",
 " print("-"*70)\n",
 " print("NOTE: BETTER/WORSE is relative to the goal of each metric.")\n",
 " print("      Fairness metrics should IMPROVE after fair clustering.")\n"
 ]
