 "# ============================================================\n",
 "# CELL 14 — BASELINE: NORMAL KMEANS\n",
 "# NEW — added by GitHub Copilot (2026-03-09)\n",
 "#\n",
 "# Runs vanilla KMeans (no fairness constraint) as baseline.\n",
 "# Returns all metrics so main() can compare vs fair clustering.\n",
 "# ============================================================\n",
 "def run_baseline(X, sensitive, feature_names):\n",
 "\n",
 " print("\n" + "="*60)\n",
 " print("BASELINE: NORMAL KMEANS (no fairness constraint)")\n",
 " print("="*60)\n",
 "\n",
 " km = KMeans(\n",
 " n_clusters=K_CLUSTERS,\n",
 " random_state=RANDOM_STATE,\n",
 " n_init=10\n",
 " )\n",
 " baseline_labels = km.fit_predict(X)\n",
 "\n",
 " print("\nCLUSTERING QUALITY")\n",
 " print("------------------")\n",
 " b_sil = silhouette_score(X, baseline_labels)\n",
 " b_db  = davies_bouldin_score(X, baseline_labels)\n",
 " print("Silhouette    :", b_sil)\n",
 " print("Davies-Bouldin:", b_db)\n",
 "\n",
 " print("\nFAIRNESS")\n",
 " print("--------")\n",
 " b_fm = fairness_metrics(baseline_labels, sensitive)\n",
 " for k, v in b_fm.items():\n",
 " print(k, ":", v)\n",
 "\n",
 " print("\nEXPLAINABILITY")\n",
 " print("--------------")\n",
 " b_em = explainability_metrics(X, baseline_labels, feature_names)\n",
 " for k, v in b_em.items():\n",
 " print(k, ":", v)\n",
 "\n",
 " print("\nPROTOTYPE QUALITY")\n",
 " print("-----------------")\n",
 " b_pq = prototype_quality(X, baseline_labels)\n",
 " print("avg_distance:", b_pq)\n",
 "\n",
 " return baseline_labels, b_sil, b_db, b_fm, b_em, b_pq\n"
 ]
 },
