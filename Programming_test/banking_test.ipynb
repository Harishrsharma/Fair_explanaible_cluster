{\n "cells": [\n {\n  "cell_type": "markdown",\n  "id": "md-title-01",\n  "metadata": {},\n  "source": [\n   "# Fair & Explainable Clustering — Banking Dataset\n",\n   "\n",\n   "**Updated by GitHub Copilot** on 2026-03-09.\n",\n   "\n",\n   "### Changes made in this update:\n",\n   "1. **Fixed `load_data()`** — now correctly unpacks all 3 return values (`X`, `sensitive`, `feature_names`) in `main()`.\n",\n   "2. **Fixed `explainability_metrics()`** — now accepts and uses `feature_names` so the decision tree has proper feature labels.\n",\n   "3. **Fixed `select_dtypes` Pandas warning** — changed `include=['object']` to `include=['string', 'object']`.\n",\n   "4. **Added `run_baseline()`** — NEW function that runs vanilla KMeans as baseline for comparison.\n",\n   "5. **Updated `main()`** — now runs BOTH baseline (KMeans) and fair clustering (Fairlet + KMedoids), then prints a side-by-side comparison table.\n",\n   "6. **Added comparison cell** — prints a formatted comparison of all metrics between Normal KMeans and Fair KMedoids.\n",\n   "\n",\n   "> **Note for student:** The previous output from the old `main()` run is preserved below the old cell for reference. Run all cells top-to-bottom on your laptop to get the full comparison output."\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "d93f0e56",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 1 — IMPORTS\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "import numpy as np\n",\n   "import pandas as pd\n",\n   "\n",\n   "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",\n   "from sklearn.compose import ColumnTransformer\n",\n   "from sklearn.cluster import KMeans\n",\n   "from sklearn.metrics import silhouette_score, davies_bouldin_score\n",\n   "from sklearn.tree import DecisionTreeClassifier, export_text\n",\n   "\n",\n   "from scipy.spatial.distance import cdist\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "01d63f7f",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 2 — CONFIGURATION CONSTANTS\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "K_CLUSTERS = 3\n",\n   "P = 1\n",\n   "Q = 1\n",\n   "RANDOM_STATE = 42\n",\n   "SAMPLE_SIZE = 1000\n",\n   "MAX_TREE_DEPTH = 5\n",\n   "MIN_NODE_SIZE = 20\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "ecc5d8a1",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 3 — LOAD DATA\n",\n   "# FIX: changed select_dtypes include=['object'] to\n",\n   "#      include=['object', 'string'] to silence Pandas4Warning.\n",\n   "# (return signature unchanged: X_processed, sensitive, feature_names)\n",\n   "# ============================================================\n",\n   "def load_data():\n",\n   "    df = pd.read_csv(\n",\n   "        r'D:\Thesis\Fair_explainable_cluster_updated_2nd_feb\data\bank-full.csv'\n",\n   "    )\n",\n   "    df['sensitive'] = df['marital'].apply(\n",\n   "        lambda x: 1 if x == 'married' else 0\n",\n   "    )\n",\n   "    drop_cols = ['marital', 'sensitive', 'y']\n",\n   "    X_raw = df.drop(columns=drop_cols)\n",\n   "    sensitive = df['sensitive'].values\n",\n   "    if SAMPLE_SIZE < len(X_raw):\n",\n   "        idx = np.random.choice(len(X_raw), SAMPLE_SIZE, replace=False)\n",\n   "        X_raw = X_raw.iloc[idx].reset_index(drop=True)\n",\n   "        sensitive = sensitive[idx]\n",\n   "    # FIX: use 'string' instead of 'object' to avoid Pandas4Warning\n",\n   "    try:\n",\n   "        categorical_cols = X_raw.select_dtypes(include=['string']).columns\n",\n   "        if len(categorical_cols) == 0:\n",\n   "            categorical_cols = X_raw.select_dtypes(include=['object']).columns\n",\n   "    except Exception:\n",\n   "        categorical_cols = X_raw.select_dtypes(include=['object']).columns\n",\n   "    numeric_cols = X_raw.select_dtypes(include=['number']).columns\n",\n   "    preprocessor = ColumnTransformer([\n",\n   "        ('num', StandardScaler(), numeric_cols),\n",\n   "        ('cat', OneHotEncoder(handle_unknown='ignore'), categorical_cols)\n",\n   "    ])\n",\n   "    X_processed = preprocessor.fit_transform(X_raw)\n",\n   "    feature_names = preprocessor.get_feature_names_out()\n",\n   "    return X_processed, sensitive, feature_names\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "bede38fa",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 4 — TREE NODE CLASS\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "class TreeNode:\n",\n   "    def __init__(self, indices, depth=0):\n",\n   "        self.indices = indices\n",\n   "        self.left = None\n",\n   "        self.right = None\n",\n   "        self.depth = depth\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "de932e1b",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 5 — BUILD SPATIAL TREE\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def build_tree(X, indices, depth=0):\n",\n   "    if depth >= MAX_TREE_DEPTH or len(indices) <= MIN_NODE_SIZE:\n",\n   "        return TreeNode(indices, depth)\n",\n   "    dim = depth % X.shape[1]\n",\n   "    values = X[indices, dim]\n",\n   "    median = np.median(values)\n",\n   "    left_indices = [i for i in indices if X[i, dim] <= median]\n",\n   "    right_indices = [i for i in indices if X[i, dim] > median]\n",\n   "    if len(left_indices) == 0 or len(right_indices) == 0:\n",\n   "        return TreeNode(indices, depth)\n",\n   "    node = TreeNode(indices, depth)\n",\n   "    node.left = build_tree(X, left_indices, depth+1)\n",\n   "    node.right = build_tree(X, right_indices, depth+1)\n",\n   "    return node\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "44d28977",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 6 — EXTRACT FAIRLETS FROM A LEAF NODE\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def extract_fairlets_from_node(indices, sensitive):\n",\n   "    reds = [i for i in indices if sensitive[i] == 1]\n",\n   "    blues = [i for i in indices if sensitive[i] == 0]\n",\n   "    fairlets = []\n",\n   "    while len(reds) >= Q and len(blues) >= P:\n",\n   "        r = [reds.pop() for _ in range(Q)]\n",\n   "        b = [blues.pop() for _ in range(P)]\n",\n   "        fairlets.append(r + b)\n",\n   "    leftovers = reds + blues\n",\n   "    return fairlets, leftovers\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "1e9b7f03",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 7 — TREE-BASED FAIRLET DECOMPOSITION\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def tree_fairlet_decomposition(node, X, sensitive):\n",\n   "    if node.left is None and node.right is None:\n",\n   "        fairlets, leftovers = extract_fairlets_from_node(\n",\n   "            node.indices, sensitive\n",\n   "        )\n",\n   "        return fairlets, leftovers\n",\n   "    left_fairlets, left_leftovers = tree_fairlet_decomposition(\n",\n   "        node.left, X, sensitive\n",\n   "    )\n",\n   "    right_fairlets, right_leftovers = tree_fairlet_decomposition(\n",\n   "        node.right, X, sensitive\n",\n   "    )\n",\n   "    combined_indices = left_leftovers + right_leftovers\n",\n   "    new_fairlets, final_leftovers = extract_fairlets_from_node(\n",\n   "        combined_indices, sensitive\n",\n   "    )\n",\n   "    total_fairlets = left_fairlets + right_fairlets + new_fairlets\n",\n   "    return total_fairlets, final_leftovers\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "65670f0b",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 8 — COMPUTE FAIRLET CENTERS (MEDOIDS)\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def compute_fairlet_centers(X, fairlets):\n",\n   "    centers = []\n",\n   "    for fl in fairlets:\n",\n   "        pts = X[fl]\n",\n   "        D = cdist(pts, pts)\n",\n   "        medoid_index = np.argmin(D.sum(axis=1))\n",\n   "        centers.append(fl[medoid_index])\n",\n   "    return np.array(centers)\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "a2c32c8b",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 9 — KMEDOIDS ALGORITHM\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def kmedoids(X, k, max_iter=100):\n",\n   "    np.random.seed(RANDOM_STATE)\n",\n   "    n = X.shape[0]\n",\n   "    medoids = np.random.choice(n, k, replace=False)\n",\n   "    for _ in range(max_iter):\n",\n   "        distances = cdist(X, X[medoids])\n",\n   "        labels = np.argmin(distances, axis=1)\n",\n   "        new_medoids = []\n",\n   "        for i in range(k):\n",\n   "            cluster_points = np.where(labels == i)[0]\n",\n   "            if len(cluster_points) == 0:\n",\n   "                new_medoids.append(medoids[i])\n",\n   "                continue\n",\n   "            cluster_distances = cdist(\n",\n   "                X[cluster_points], X[cluster_points]\n",\n   "            )\n",\n   "            best = cluster_points[np.argmin(cluster_distances.sum(axis=1))]\n",\n   "            new_medoids.append(best)\n",\n   "        new_medoids = np.array(new_medoids)\n",\n   "        if np.all(new_medoids == medoids):\n",\n   "            break\n",\n   "        medoids = new_medoids\n",\n   "    return labels, medoids\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "c319e0e3",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 10 — ASSIGN LABELS HELPER\n",\n   "# (unchanged from original — note: main() now uses this\n",\n   "#  function directly instead of the inline loop)\n",\n   "# ============================================================\n",\n   "def assign_labels(fairlets, center_labels, n):\n",\n   "    labels = np.zeros(n, dtype=int)\n",\n   "    for fl, lab in zip(fairlets, center_labels):\n",\n   "        for idx in fl:\n",\n   "            labels[idx] = lab\n",\n   "    return labels\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "af91ca19",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 11 — FAIRNESS METRICS\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def fairness_metrics(labels, sensitive):\n",\n   "    K = len(np.unique(labels))\n",\n   "    balances = []\n",\n   "    violations = 0\n",\n   "    global_ratio = sensitive.mean()\n",\n   "    dp_gaps = []\n",\n   "    for k in range(K):\n",\n   "        mask = labels == k\n",\n   "        group = sensitive[mask]\n",\n   "        n0 = np.sum(group == 0)\n",\n   "        n1 = np.sum(group == 1)\n",\n   "        if max(n0, n1) == 0:\n",\n   "            continue\n",\n   "        balance = min(n0, n1) / max(n0, n1)\n",\n   "        balances.append(balance)\n",\n   "        if balance < 1.0:   # p:q = 1:1\n",\n   "            violations += 1\n",\n   "        cluster_ratio = group.mean()\n",\n   "        dp_gaps.append(abs(cluster_ratio - global_ratio))\n",\n   "    return {\n",\n   "        \"avg_balance\": np.mean(balances),\n",\n   "        \"violation_rate\": violations / K,\n",\n   "        \"avg_dp_gap\": np.mean(dp_gaps)\n",\n   "    }\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "2e1abfce",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 12 — EXPLAINABILITY METRICS\n",\n   "# FIX: now accepts feature_names parameter so the decision\n",\n   "#      tree knows the real column names (e.g. 'num__age',\n",\n   "#      'cat__job_admin.' etc.) instead of generic feature_0.\n",\n   "# ============================================================\n",\n   "def explainability_metrics(X, labels, feature_names=None):\n",\n   "    clf = DecisionTreeClassifier(max_depth=4, random_state=42)\n",\n   "    clf.fit(X, labels)\n",\n   "    result = {\n",\n   "        \"tree_fidelity\": clf.score(X, labels),\n",\n   "        \"tree_depth\": clf.get_depth(),\n",\n   "        \"tree_leaves\": clf.get_n_leaves()\n",\n   "    }\n",\n   "    # Print the human-readable tree rules if feature names are provided\n",\n   "    if feature_names is not None:\n",\n   "        print(\"\\nDecision Tree Rules:\")\n",\n   "        print(export_text(clf, feature_names=list(feature_names)))\n",\n   "    return result\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "b1f1bf91",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 13 — PROTOTYPE QUALITY\n",\n   "# (unchanged from original)\n",\n   "# ============================================================\n",\n   "def prototype_quality(X, labels):\n",\n   "    K = len(np.unique(labels))\n",\n   "    distances = []\n",\n   "    for k in range(K):\n",\n   "        pts = X[labels == k]\n",\n   "        center = pts.mean(axis=0)\n",\n   "        d = np.linalg.norm(pts - center, axis=1)\n",\n   "        distances.append(np.mean(d))\n",\n   "    return np.mean(distances)\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "baseline-new-01",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 14 — BASELINE: NORMAL KMEANS\n",\n   "# NEW (added by GitHub Copilot, 2026-03-09)\n",\n   "#\n",\n   "# Runs vanilla KMeans as the baseline (no fairness constraint).\n",\n   "# Returns labels and all metric dictionaries so they can be\n",\n   "# compared against the fair clustering results in main().\n",\n   "# ============================================================\n",\n   "def run_baseline(X, sensitive, feature_names):\n",\n   "    print(\"\\n\" + \"=\"*60)\n",\n   "    print(\"BASELINE: NORMAL KMEANS (no fairness constraint)\")\n",\n   "    print(\"=\"*60)\n",\n   "    km = KMeans(\n",\n   "        n_clusters=K_CLUSTERS,\n",\n   "        random_state=RANDOM_STATE,\n",\n   "        n_init=10\n",\n   "    )\n",\n   "    baseline_labels = km.fit_predict(X)\n",\n   "    print(\"\\nCLUSTERING QUALITY\")\n",\n   "    print(\"------------------\")\n",\n   "    b_sil = silhouette_score(X, baseline_labels)\n",\n   "    b_db  = davies_bouldin_score(X, baseline_labels)\n",\n   "    print(\"Silhouette    :\", b_sil)\n",\n   "    print(\"Davies-Bouldin:\", b_db)\n",\n   "    print(\"\\nFAIRNESS\")\n",\n   "    print(\"--------\")\n",\n   "    b_fm = fairness_metrics(baseline_labels, sensitive)\n",\n   "    for k, v in b_fm.items():\n",\n   "        print(k, \":\", v)\n",\n   "    print(\"\\nEXPLAINABILITY\")\n",\n   "    print(\"--------------\")\n",\n   "    b_em = explainability_metrics(X, baseline_labels, feature_names)\n",\n   "    for k, v in b_em.items():\n",\n   "        print(k, \":\", v)\n",\n   "    print(\"\\nPROTOTYPE QUALITY\")\n",\n   "    print(\"-----------------\")\n",\n   "    b_pq = prototype_quality(X, baseline_labels)\n",\n   "    print(\"avg_distance:\", b_pq)\n",\n   "    return baseline_labels, b_sil, b_db, b_fm, b_em, b_pq\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "4db6fcbe",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 15 — MAIN FUNCTION\n",\n   "# FIXES:\n",\n   "#   1. load_data() now unpacks all 3 return values\n",\n   "#      (X, sensitive, feature_names) — was only unpacking 2.\n",\n   "#   2. assign_labels() helper is now used instead of\n",\n   "#      the duplicate inline loop.\n",\n   "#   3. explainability_metrics() now receives feature_names.\n",\n   "#   4. run_baseline() is called first, then fair clustering,\n",\n   "#      then a side-by-side comparison table is printed.\n",\n   "# ============================================================\n",\n   "def main():\n",\n   "    # ----------------------------------------------------------\n",\n   "    # STEP 1 — Load & preprocess data\n",\n   "    # ----------------------------------------------------------\n",\n   "    print(\"Loading data...\")\n",\n   "    # FIX: unpack all 3 values (was missing feature_names)\n",\n   "    X, sensitive, feature_names = load_data()\n",\n   "    print(\"Data shape     :\", X.shape)\n",\n   "    print(\"Sensitive attr :\", sensitive.sum(), \"married /\",\n",\n   "          (sensitive == 0).sum(), \"non-married\")\n",\n   "    # ----------------------------------------------------------\n",\n   "    # STEP 2 — Run BASELINE (Normal KMeans)\n",\n   "    # ----------------------------------------------------------\n",\n   "    (\n",\n   "        baseline_labels,\n",\n   "        b_sil, b_db,\n",\n   "        b_fm, b_em, b_pq\n",\n   "    ) = run_baseline(X, sensitive, feature_names)\n",\n   "    # ----------------------------------------------------------\n",\n   "    # STEP 3 — Run FAIR CLUSTERING (Fairlet + KMedoids)\n",\n   "    # ----------------------------------------------------------\n",\n   "    print(\"\\n\" + \"=\"*60)\n",\n   "    print(\"FAIR CLUSTERING: FAIRLET DECOMPOSITION + KMEDOIDS\")\n",\n   "    print(\"=\"*60)\n",\n   "    print(\"\\nBuilding spatial tree...\")\n",\n   "    root = build_tree(X, list(range(len(X))))\n",\n   "    print(\"Running tree-based fairlet decomposition...\")\n",\n   "    fairlets, leftovers = tree_fairlet_decomposition(\n",\n   "        root, X, sensitive\n",\n   "    )\n",\n   "    print(\"\\nFAIRLET SUMMARY\")\n",\n   "    print(\"----------------\")\n",\n   "    print(\"Total fairlets        :\", len(fairlets))\n",\n   "    print(\"Total assigned points :\", sum(len(fl) for fl in fairlets))\n",\n   "    print(\"Leftovers (unassigned):\", len(leftovers))\n",\n   "    # Compute medoids of fairlets\n",\n   "    centers = compute_fairlet_centers(X, fairlets)\n",\n   "    center_labels, medoids = kmedoids(\n",\n   "        X[centers],\n",\n   "        K_CLUSTERS\n",\n   "    )\n",\n   "    # FIX: use assign_labels() helper (was duplicate inline loop)\n",\n   "    fair_labels = assign_labels(fairlets, center_labels, len(X))\n",\n   "    # Assign leftover points to nearest cluster\n",\n   "    if len(leftovers) > 0:\n",\n   "        medoid_points = X[centers][medoids]\n",\n   "        distances = cdist(X[leftovers], medoid_points)\n",\n   "        leftover_labels = np.argmin(distances, axis=1)\n",\n   "        for idx, lab in zip(leftovers, leftover_labels):\n",\n   "            fair_labels[idx] = lab\n",\n   "        print(\"Leftovers assigned to nearest clusters.\")\n",\n   "    print(\"\\nCLUSTERING QUALITY\")\n",\n   "    print(\"------------------\")\n",\n   "    f_sil = silhouette_score(X, fair_labels)\n",\n   "    f_db  = davies_bouldin_score(X, fair_labels)\n",\n   "    print(\"Silhouette    :\", f_sil)\n",\n   "    print(\"Davies-Bouldin:\", f_db)\n",\n   "    print(\"\\nFAIRNESS\")\n",\n   "    print(\"--------\")\n",\n   "    f_fm = fairness_metrics(fair_labels, sensitive)\n",\n   "    for k, v in f_fm.items():\n",\n   "        print(k, \":\", v)\n",\n   "    print(\"\\nEXPLAINABILITY\")\n",\n   "    print(\"--------------\")\n",\n   "    # FIX: pass feature_names so the tree uses real column names\n",\n   "    f_em = explainability_metrics(X, fair_labels, feature_names)\n",\n   "    for k, v in f_em.items():\n",\n   "        print(k, \":\", v)\n",\n   "    print(\"\\nPROTOTYPE QUALITY\")\n",\n   "    print(\"-----------------\")\n",\n   "    f_pq = prototype_quality(X, fair_labels)\n",\n   "    print(\"avg_distance:\", f_pq)\n",\n   "    # ----------------------------------------------------------\n",\n   "    # STEP 4 — SIDE-BY-SIDE COMPARISON TABLE\n",\n   "    # NEW (added by GitHub Copilot, 2026-03-09)\n",\n   "    # ----------------------------------------------------------\n",\n   "    print(\"\\n\" + \"=\"*60)\n",\n   "    print(\"COMPARISON: NORMAL KMEANS  vs  FAIR KMEDOIDS\")\n",\n   "    print(\"=\"*60)\n",\n   "    print(f\"{'Metric':<30} {'KMeans':>12} {'Fair KMedoids':>15} {'Change':>10}\")\n",\n   "    print(\"-\"*70)\n",\n   "    def row(label, v1, v2, higher_is_better=True):\n",\n   "        diff = v2 - v1\n",\n   "        if higher_is_better:\n",\n   "            arrow = \"BETTER\" if diff > 0 else (\"WORSE\" if diff < 0 else \"SAME\")\n",\n   "        else:\n",\n   "            arrow = \"BETTER\" if diff < 0 else (\"WORSE\" if diff > 0 else \"SAME\")\n",\n   "        print(f\"{label:<30} {v1:>12.4f} {v2:>15.4f} {arrow:>10}\")\n",\n   "    print(\"--- CLUSTERING QUALITY ---\")\n",\n   "    row(\"Silhouette Score\",      b_sil,                f_sil,                higher_is_better=True)\n",\n   "    row(\"Davies-Bouldin Score\",  b_db,                 f_db,                 higher_is_better=False)\n",\n   "    print(\"--- FAIRNESS ---\")\n",\n   "    row(\"avg_balance\",           b_fm['avg_balance'],  f_fm['avg_balance'],  higher_is_better=True)\n",\n   "    row(\"violation_rate\",        b_fm['violation_rate'],f_fm['violation_rate'],higher_is_better=False)\n",\n   "    row(\"avg_dp_gap\",            b_fm['avg_dp_gap'],   f_fm['avg_dp_gap'],   higher_is_better=False)\n",\n   "    print(\"--- EXPLAINABILITY ---\")\n",\n   "    row(\"tree_fidelity\",         b_em['tree_fidelity'],f_em['tree_fidelity'],higher_is_better=True)\n",\n   "    row(\"tree_depth\",            b_em['tree_depth'],   f_em['tree_depth'],   higher_is_better=False)\n",\n   "    row(\"tree_leaves\",           b_em['tree_leaves'],  f_em['tree_leaves'],  higher_is_better=False)\n",\n   "    print(\"--- PROTOTYPE QUALITY ---\")\n",\n   "    row(\"avg_distance\",          b_pq,                 f_pq,                 higher_is_better=False)\n",\n   "    print(\"-\"*70)\n",\n   "    print(\"NOTE: BETTER/WORSE is relative to the goal of each metric.\")\n",\n   "    print(\"      Fairness metrics should IMPROVE (lower violation_rate,\")\n",\n   "    print(\"      lower dp_gap, higher avg_balance) after fair clustering.\")\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "ee50917f",\n  "metadata": {},\n  "outputs": [\n   {\n    "name": "stdout",\n    "output_type": "stream",\n    "text": [\n     "Loading data...\n",\n     "Building spatial tree...\n",\n     "Running tree-based fairlet decomposition...\n",\n     "\n",\n     "FAIRLET SUMMARY\n",\n     "----------------\n",\n     "Total fairlets: 327\n",\n     "Total assigned points: 654\n",\n     "Leftovers (unassigned): 346\n",\n     "Leftovers assigned to nearest clusters.\n",\n     "\n",\n     "CLUSTERING QUALITY\n",\n     "------------------\n",\n     "Silhouette: 0.028280387525811638\n",\n     "Davies-Bouldin: 4.354095400585686\n",\n     "\n",\n     "FAIRNESS\n",\n     "--------\n",\n     "avg_balance : 0.5052515300791164\n",\n     "violation_rate : 1.0\n",\n     "avg_dp_gap : 0.02373685542593103\n",\n     "\n",\n     "EXPLAINABILITY\n",\n     "--------------\n",\n     "tree_fidelity : 0.753\n",\n     "tree_depth : 4\n",\n     "tree_leaves : 16\n",\n     "\n",\n     "PROTOTYPE QUALITY\n",\n     "-----------------\n",\n     "avg_distance: 3.0956377337096885\n",\n     "\n",\n     "NOTE: Output above is from the original single-pipeline run (fair clustering only).\n",\n     "Run main() below to get the full updated output with baseline comparison.\n"\n    ]\n   }\n  ],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 16 — PRESERVED ORIGINAL OUTPUT (for reference)\n",\n   "# This cell shows the output from the original run before\n",\n   "# the baseline comparison was added. It will NOT re-run\n",\n   "# (execution_count is null). Run main() in the next cell\n",\n   "# to get the full updated comparison output.\n",\n   "# ============================================================\n",\n   "# (This cell is intentionally left without source code.\n",\n   "#  The output below is the preserved original result.)\n"\n  ]\n },\n {\n  "cell_type": "code",\n  "execution_count": null,\n  "id": "run-main-new-01",\n  "metadata": {},\n  "outputs": [],\n  "source": [\n   "# ============================================================\n",\n   "# CELL 17 — RUN FULL PIPELINE (Baseline + Fair + Comparison)\n",\n   "# NEW (added by GitHub Copilot, 2026-03-09)\n",\n   "#\n",\n   "# Run this cell on your laptop to get:\n",\n   "#   1. Baseline KMeans metrics\n",\n   "#   2. Fair KMedoids metrics\n",\n   "#   3. Side-by-side comparison table\n",\n   "# ============================================================\n",\n   "main()\n"\n  ]\n }\n ],\n "metadata": {\n  "kernelspec": {\n   "disp